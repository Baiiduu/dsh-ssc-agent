{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aaub-software:ssc-sast:v1",
  "title": "SSC SAST Scan Result v1",
  "description": "Scanner-neutral, model-facing result returned by an SSC SAST plugin.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "scanner",
    "scannedPaths",
    "findings",
    "diagnostics",
    "summary"
  ],
  "properties": {
    "schemaVersion": {
      "const": "ssc-sast/v1"
    },
    "status": {
      "enum": [
        "completed",
        "partial"
      ]
    },
    "scanner": {
      "$ref": "#/$defs/scanner"
    },
    "scannedPaths": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/workspacePath"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    }
  },
  "$defs": {
    "workspacePath": {
      "type": "string",
      "minLength": 1,
      "description": "Forward-slash workspace-relative path that does not expose a host absolute path."
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "startLine",
        "startColumn",
        "endLine",
        "endColumn"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/workspacePath"
        },
        "startLine": {
          "type": "integer",
          "minimum": 1
        },
        "startColumn": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        },
        "endColumn": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "scanner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "components": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "configuration": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "severity": {
      "enum": [
        "info",
        "warning",
        "error"
      ]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "severity"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "cwe": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^CWE-[1-9][0-9]*$"
          }
        },
        "owasp": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "jsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "locations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/location"
          }
        },
        "data": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      },
      "additionalProperties": true
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scanner",
        "rule",
        "message",
        "location",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "scanner": {
          "type": "string",
          "minLength": 1
        },
        "rule": {
          "$ref": "#/$defs/rule"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "type",
        "message"
      ],
      "properties": {
        "level": {
          "$ref": "#/$defs/severity"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": [
            "number",
            "string"
          ]
        },
        "location": {
          "$ref": "#/$defs/location"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalFindings",
        "returnedFindings",
        "truncated",
        "durationMs"
      ],
      "properties": {
        "scannedFiles": {
          "type": "integer",
          "minimum": 0
        },
        "totalFindings": {
          "type": "integer",
          "minimum": 0
        },
        "returnedFindings": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
